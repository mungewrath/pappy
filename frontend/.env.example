# Copy to .env.local for local development.

# FastAPI running locally under uvicorn (see backend/README.md).
# Once deployed, set this to the API Gateway HTTP API invoke URL.
VITE_API_BASE_URL=http://localhost:8000

# Cognito Hosted UI (§7.1) — from `terraform output` after applying the
# `auth` module. These are public client identifiers, not secrets (the SPA
# is a public OAuth client with no client secret). Values below are the
# current dev deployment. The API rejects requests with no valid JWT (401),
# so these are needed even for local dev against the deployed API.
VITE_COGNITO_USER_POOL_ID=us-west-2_c6MwXmEXz
VITE_COGNITO_CLIENT_ID=1vngp9htjttq552ljjget5ue42
VITE_COGNITO_DOMAIN=mungewrath-pappy.auth.us-west-2.amazoncognito.com
VITE_COGNITO_REGION=us-west-2

# Dev-only: data endpoints derive employerId from the JWT `sub` claim;
# without Cognito configured locally this pins requests to one principal.
# Never set in deployed environments (§7.1).
PAPPY_DEV_FALLBACK_SUB=local-dev-user